{
  "contractVersion": 1,
  "kind": "software",
  "id": "nfs",
  "version": "0.1.0",
  "playbooks": [
    "deploy-nfs",
    "uninstall-nfs"
  ],
  "workflowKinds": [
    "configure-nfs",
    "uninstall-nfs"
  ],
  "taskKinds": [],
  "completions": [],
  "spec": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "exportPath": {
        "type": "string",
        "title": "Export path (server)",
        "description": "Required when a Server takes the server role.",
        "examples": ["/export/data"]
      },
      "exportOptions": {
        "type": "string",
        "title": "Export options (server)",
        "examples": ["rw,sync,no_subtree_check,root_squash"]
      },
      "source": {
        "type": "string",
        "title": "Source (client)",
        "description": "Required when a Server takes the client role (host:/path).",
        "examples": ["10.0.0.9:/export/data"]
      },
      "mountPath": {
        "type": "string",
        "title": "Mount path (client)",
        "examples": ["/shared"]
      },
      "mountOptions": {
        "type": "string",
        "title": "Mount options (client)",
        "examples": ["rw,_netdev"]
      }
    }
  },
  "hooks": [
    {
      "name": "software",
      "reason": "Requires the export or mount fields by the roles the targets take and splits the targets into server and client lists for the playbook; the catalog entry travels with it."
    }
  ],
  "capabilities": [
    "host-automation"
  ],
  "routes": []
}
