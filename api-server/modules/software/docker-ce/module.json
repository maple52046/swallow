{
  "contractVersion": 1,
  "kind": "software",
  "id": "docker-ce",
  "version": "0.1.0",
  "playbooks": [
    "deploy-docker-ce",
    "uninstall-docker-ce"
  ],
  "workflowKinds": [
    "configure-docker-ce",
    "uninstall-docker-ce"
  ],
  "taskKinds": [],
  "completions": [],
  "hooks": [
    {
      "name": "software",
      "reason": "Validates enableApi as a real boolean, records an omitted value as true, and passes the Engine API port the Docker Host Explorer dials; the catalog entry travels with it."
    }
  ],
  "capabilities": [
    "host-automation"
  ],
  "routes": [
    "/api/v1/servers/{id}/docker",
    "/api/v1/software/docker-ce/registry-credentials"
  ],
  "artifacts": {
    "sources": [
      {
        "name": "docker-ce",
        "format": "deb",
        "url": "https://download.docker.com/linux/ubuntu",
        "suites": ["noble"],
        "components": ["stable"],
        "architectures": ["amd64"]
      }
    ]
  }
}
