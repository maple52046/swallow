# Managed by Swallow (Grafana Managed Software). Do not edit by hand; changes are overwritten.
apiVersion: 1

datasources:
  - name: prometheus
    uid: {{ grafana_datasource_uid }}
    type: prometheus
    access: proxy
    url: {{ grafana_datasource_url | trim | to_json }}
    isDefault: true
    editable: false
{% if grafana_datasource_token | length > 0 %}
    jsonData:
      httpHeaderName1: Authorization
    secureJsonData:
      httpHeaderValue1: "$__env{SWALLOW_DATASOURCE_AUTHORIZATION}"
{% endif %}
