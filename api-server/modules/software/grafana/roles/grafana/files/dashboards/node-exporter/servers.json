{
  "annotations": {
    "list": []
  },
  "description": "Basic monitoring of the Platform's Servers from their Node Exporter, as the Site Prometheus collects it.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage",
      "description": "Share of CPU time not idle, averaged over every CPU of the Server.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - avg by (server_id) (rate(node_cpu_seconds_total{mode=\"idle\", server_id=~\"$server_id\"}[$__rate_interval]))) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory used",
      "description": "Memory not available to new processes (MemTotal minus MemAvailable).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - max by (server_id) (node_memory_MemAvailable_bytes{server_id=~\"$server_id\"}) / max by (server_id) (node_memory_MemTotal_bytes{server_id=~\"$server_id\"})) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Root filesystem used",
      "description": "Space used on the filesystem mounted at /. A memory-backed root the exporter does not report shows no data.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (1 - max by (server_id) (node_filesystem_avail_bytes{mountpoint=\"/\", server_id=~\"$server_id\"}) / max by (server_id) (node_filesystem_size_bytes{mountpoint=\"/\", server_id=~\"$server_id\"})) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Load average",
      "description": "Run-queue length over 1, 5, and 15 minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (server_id) (node_load1{server_id=~\"$server_id\"}) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}} 1m",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (server_id) (node_load5{server_id=~\"$server_id\"}) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}} 5m",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (server_id) (node_load15{server_id=~\"$server_id\"}) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}} 15m",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network traffic",
      "description": "Bytes per second received and transmitted on physical and bonded interfaces; loopback and container or bridge interfaces are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (server_id) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*\", server_id=~\"$server_id\"}[$__rate_interval])) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}} receive",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (server_id) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*|virbr.*|cni.*|flannel.*|cali.*|vxlan.*|tun.*|tap.*\", server_id=~\"$server_id\"}[$__rate_interval])) * on (server_id) group_left (nodename) max by (server_id, nodename) (node_uname_info{server_id=~\"$server_id\"})",
          "legendFormat": "{{nodename}} transmit",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "swallow",
    "node-exporter"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(node_uname_info, server_id)",
        "description": "The swallow Server ids of the Platform's members; the panels name each Server by its hostname.",
        "hide": 0,
        "includeAll": true,
        "allValue": ".+",
        "label": "Server",
        "multi": true,
        "name": "server_id",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(node_uname_info, server_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Servers",
  "uid": "swallow-node-exporter",
  "version": 1
}
