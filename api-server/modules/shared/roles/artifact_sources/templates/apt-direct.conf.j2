// Managed by Swallow (artifact_sources): apt reaches the Site's Local Repository directly, never
// through the host's apt proxy.
{% set uris = swallow_artifacts.deb | map(attribute='uri') | list %}
{% for scheme, host in uris | map('urlsplit', 'scheme') | zip(uris | map('urlsplit', 'hostname')) | unique %}
Acquire::{{ scheme }}::Proxy::{{ host }} "DIRECT";
{% endfor %}
