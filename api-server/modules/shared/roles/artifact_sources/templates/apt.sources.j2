{% if artifact_sources_apt_from == 'local_repository' %}
# Managed by Swallow (artifact_sources): the Site's Local Repository. The host's other sources are
# renamed with the {{ artifact_sources_disabled_suffix }} suffix.
{% else %}
# Managed by Swallow (artifact_sources): the upstream sources swallow's modules declare, next to the
# host's own, each signed by the key its module declares.
{% endif %}
{% for source in artifact_sources_deb %}

Types: deb
URIs: {{ source.uri }}
Suites: {{ source.suites | join(' ') }}
Components: {{ source.components | join(' ') }}
Signed-By: {{ artifact_sources_keyring if artifact_sources_apt_from == 'local_repository'
              else artifact_sources_upstream_keyring_prefix ~ source.name ~ '.gpg' }}
{% endfor %}
