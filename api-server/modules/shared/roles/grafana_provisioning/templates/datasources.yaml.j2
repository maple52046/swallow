# Managed by Swallow (Grafana Managed Software). Do not edit by hand; changes are overwritten.
apiVersion: 1

datasources:
  - name: prometheus
    uid: {{ grafana_provisioning_datasource_uid }}
    type: prometheus
    access: proxy
    url: {{ grafana_provisioning_url | trim | to_json }}
    isDefault: true
    editable: false
{% if grafana_provisioning_token | bool %}
    jsonData:
      httpHeaderName1: Authorization
    secureJsonData:
      httpHeaderValue1: "{{ '$__env{' ~ grafana_provisioning_token_variable ~ '}' }}"
{% endif %}
