{
  "contractVersion": 1,
  "kind": "platform",
  "id": "kubernetes",
  "version": "0.1.0",
  "playbooks": [
    "deploy-kubernetes",
    "uninstall-kubernetes",
    "configure-kubernetes-grafana"
  ],
  "workflowKinds": [
    "deploy-kubernetes",
    "uninstall-kubernetes"
  ],
  "taskKinds": [],
  "completions": [
    "kubernetes-credential"
  ],
  "hooks": [
    {
      "name": "platform-reader",
      "reason": "Builds the membership reader of a deployed cluster from its Connection: plain REST against the Kubernetes API, and the k0s controller leases when the Integration enables them."
    },
    {
      "name": "platform-credential",
      "reason": "Turns the k0s credential role's result into the cluster's read Integration: endpoint, token, and the CA to verify the API with, or insecureSkipVerify for an earlier role that returned none."
    },
    {
      "name": "platform",
      "reason": "Converts between the Platform spec and the Kubernetes deploy request (members as roleAssignments) and classifies a spec change per desired-state-model §5.2, marking what swallow cannot carry out yet."
    }
  ],
  "capabilities": [
    "host-automation",
    "os-provisioning"
  ],
  "routes": [
    "/api/v1/platforms/{id}/kubernetes"
  ],
  "artifacts": {
