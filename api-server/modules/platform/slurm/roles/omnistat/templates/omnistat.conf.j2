# Managed by Swallow (configure-omnistat). Do not edit by hand; changes are overwritten.
[omnistat.collectors]
port = {{ omnistat_port }}
enable_rocm_smi = False
enable_amd_smi = {{ 'True' if omnistat_gpu | bool else 'False' }}
enable_ras_ecc = False
enable_rms = True
enable_rocprofiler = {{ 'True' if omnistat_rocprofiler_enabled | default(false) | bool else 'False' }}
enable_network = True
enable_vendor_counters = False
enable_host_metrics = True
enable_kernel_trace = False
enable_external = False
rocm_path = {{ omnistat_rocm_path }}
# Only this node and the Site Prometheus may scrape the exporter.
allowed_ips = {{ (['127.0.0.1'] + omnistat_scrape_addresses) | unique | join(', ') }}

[omnistat.collectors.rms]
enable_annotations = True
job_detection_mode = file-based
job_detection_file = {{ omnistat_job_file }}

[omnistat.collectors.host]
enable_proc_io_stats = False
cpu_load_sampling_interval = 0.05
{% if omnistat_rocprofiler_enabled | default(false) | bool %}

# The hardware counters the deployment asked for, which this node's probe sampled.
[omnistat.collectors.rocprofiler]
profile = {{ omnistat_counter_profile }}

[omnistat.collectors.rocprofiler.{{ omnistat_counter_profile }}]
sampling_mode = constant
counters = {{ omnistat_counters | to_json }}
{% endif %}

[omnistat.query]
# omnistat-query reads the Site Prometheus through the Platform Grafana's read-only datasource proxy,
# which reaches it through swallow's gateway with the Platform's token and already serves the same
# data to anonymous viewers.
prometheus_url = http://{{ omnistat_observability_address }}:{{ omnistat_grafana_port }}/api/datasources/proxy/uid/{{ omnistat_grafana_datasource_uid }}
system_name = {{ omnistat_system_name }}
