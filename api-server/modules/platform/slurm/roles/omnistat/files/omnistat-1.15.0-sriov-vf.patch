# Omnistat v1.15.0 compatibility patch for SR-IOV virtual functions (decision 063).
# An MI308X VF exposes inventory and memory APIs but rejects amdsmi_get_gpu_metrics_info and
# the temperature query; upstream v1.15.0 then aborts the exporter. This degrades only the bulk
# metrics path to unavailable and never fabricates utilization, power, clock, or temperature.
# Re-check upstream before bumping the Omnistat version.
--- a/omnistat/collector_amdsmi.py
+++ b/omnistat/collector_amdsmi.py
@@ -106,6 +106,7 @@
