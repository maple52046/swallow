{
  "contractVersion": 1,
  "kind": "accelerator",
  "id": "amd",
  "version": "0.1.0",
  "playbooks": [
    "configure-amd-gpu-operator",
    "validate-amd-gpu-basic"
  ],
  "workflowKinds": [
    "configure-gpu-operator",
    "install-gpu-driver"
  ],
  "taskKinds": [],
  "completions": [
    "gpu-operator-state"
  ],
  "hooks": [
    {
      "name": "accelerator",
      "reason": "Recognizes AMD workload GPUs in a Server's inventory by provider vendor name or by the 1002 PCI vendor id, which a GPU inventory record cannot say by itself."
    }
  ],
  "capabilities": [
    "host-automation"
  ],
  "routes": [
    "/api/v1/platforms/gpu-operator/releases",
    "/api/v1/platforms/{id}/gpu-operator"
  ],
  "artifacts": {
    "images": [
      "docker.io/rocm/gpu-operator:v1.5.1",
      "registry.k8s.io/nfd/node-feature-discovery:v0.18.3",
      "docker.io/rocm/k8s-device-plugin:1.31.0.11",
      "docker.io/rocm/k8s-device-plugin:labeller-1.31.0.11",
      "docker.io/rocm/gpu-operator-utils:v1.5.1",
      "docker.io/rocm/device-metrics-exporter:v1.5.1",
      "docker.io/rocm/k8s-gpu-dra-driver:v1.0.1",
      "docker.io/library/busybox:1.36"
    ]
  },
  "templates": {
    "amd-gpu-basic": {
      "version": 1,
      "jobs": [
        {
          "name": "validate-amd-gpus",
          "label": "Validate AMD GPUs",
          "retry": "job"
        }
      ],
      "tasks": [
        {
          "id": "amd-gpu-basic",
          "name": "Check the AMD GPUs",
          "job": "validate-amd-gpus",
          "content": {
            "type": "host-automation",
            "playbook": "validate-amd-gpu-basic"
          },
          "targets": "servers",
          "timeoutSeconds": 900
        }
      ]
    }
  },
  "validations": [
    {
      "id": "amd-gpu-basic",
      "title": "AMD GPU basics",
      "description": "Checks that the amdgpu driver brings up every AMD GPU each Server has on PCI, and that every GPU it brings up allocates, fills, and frees memory through the HIP runtime, three times. A Server without an AMD GPU skips both checks.",
      "target": "servers",
      "impact": "workload",
      "budgetSeconds": 1200,
      "experimental": true,
      "template": "amd-gpu-basic",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedGpus": {
            "type": "integer",
            "title": "Expected GPUs",
            "description": "The GPUs the driver must bring up on each Server. Default: the AMD GPUs on its PCI bus, without those passed through to VMs.",
            "minimum": 0,
            "maximum": 64
          }
        }
      },
      "checks": [
        {
          "id": "kfd-gpus",
          "title": "Driver brings up the GPUs",
          "description": "The kernel's KFD topology lists as many GPUs as are expected.",
          "gating": true
        },
        {
          "id": "hip-probe",
          "title": "HIP probe",
          "description": "Every GPU the driver brings up allocates, fills, and frees memory through the HIP runtime, three times.",
          "gating": true
        }
      ]
    }
  ]
}
