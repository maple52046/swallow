{
  "contractVersion": 1,
  "kind": "accelerator",
  "id": "amd",
  "version": "0.1.0",
  "playbooks": [
    "configure-amd-gpu-operator"
  ],
  "workflowKinds": [
    "configure-gpu-operator",
    "install-gpu-driver"
  ],
  "taskKinds": [],
  "completions": [
    "gpu-operator-state"
  ],
  "hooks": [
    {
      "name": "accelerator",
      "reason": "Recognizes AMD workload GPUs in a Server's inventory by provider vendor name or by the 1002 PCI vendor id, which a GPU inventory record cannot say by itself."
    }
  ],
  "capabilities": [
    "host-automation"
  ],
  "routes": [
    "/api/v1/platforms/gpu-operator/releases",
    "/api/v1/platforms/{id}/gpu-operator"
  ],
  "artifacts": {
    "images": [
      "docker.io/rocm/gpu-operator:v1.5.1",
      "registry.k8s.io/nfd/node-feature-discovery:v0.18.3",
      "docker.io/rocm/k8s-device-plugin:1.31.0.11",
      "docker.io/rocm/k8s-device-plugin:labeller-1.31.0.11",
      "docker.io/rocm/gpu-operator-utils:v1.5.1",
      "docker.io/rocm/device-metrics-exporter:v1.5.1",
      "docker.io/rocm/k8s-gpu-dra-driver:v1.0.1",
      "docker.io/library/busybox:1.36"
    ]
  }
}
