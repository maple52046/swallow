# Managed by Swallow (deploy-slurm). Do not edit by hand; changes are overwritten on redeploy.
ClusterName={{ swallow_slurm_cluster_name }}
SlurmUser=slurm
{% for cid in swallow_slurm_controller_ids %}
SlurmctldHost={{ hostvars[cid].slurm_node_name }}({{ hostvars[cid].ansible_host }})
{% endfor %}

# Authentication: MUNGE for daemon-to-daemon, JWT so slurmrestd can accept bearer tokens.
AuthType=auth/munge
AuthAltTypes=auth/jwt
AuthAltParameters=jwt_key={{ slurm_jwt_key_path }}

# Configless: compute nodes fetch this file from a controller via --conf-server.
SlurmctldParameters=enable_configless

StateSaveLocation={{ slurm_state_save_location }}
SlurmdSpoolDir=/var/spool/slurmd
ReturnToService=2

# Scheduling and resource selection (cgroup v2 core+memory containment).
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
ProctrackType=proctrack/cgroup
TaskPlugin=task/cgroup,task/affinity
# A job that names no memory gets memory in proportion to its CPUs instead of the whole node, so
# jobs that share a node do not wait on memory nobody uses (the lowest per-CPU share of any node).
DefMemPerCPU={{ slurm_def_mem_per_cpu }}

# Job hooks: Swallow's dispatchers are the only Prolog and Epilog. They run every hook in
# prolog.d/epilog.d on the compute node (installed there by deploy-slurm; configless does not
# distribute scripts), and a failing hook never drains the node.
Prolog={{ slurm_conf_dir }}/swallow-prolog
Epilog={{ slurm_conf_dir }}/swallow-epilog
# Contain (the job's processes in its cgroup) implies Alloc: the Prolog runs when the job is
# allocated, so attribution hooks see the job before it starts.
PrologFlags=Alloc,Contain
MpiDefault=none
{% set gres_state = namespace(any=false) %}
{% for nid in swallow_slurm_compute_ids %}
{% if hostvars[nid].slurm_node_gres | default('') %}
{% set gres_state.any = true %}
{% endif %}
{% endfor %}
{% if gres_state.any %}

# Generic resources: AMD GPUs mapped from each node's KFD topology (see gres.conf).
GresTypes=gpu
{% endif %}

SlurmctldTimeout=120
SlurmdTimeout=300

# Logging
SlurmctldLogFile={{ slurm_log_dir }}/slurmctld.log
SlurmdLogFile={{ slurm_log_dir }}/slurmd.log

# Compute nodes. The NodeName line is what slurmd -C detected on each host (minus any GRES it
# reported), with RealMemory lowered by the memory kept for the operating system, the connection
# address pinned via NodeAddr so the controller reaches nodes without DNS, and the GPU GRES Swallow
# mapped from the node's KFD topology.
{% for nid in swallow_slurm_compute_ids %}
{% set gres = hostvars[nid].slurm_node_gres | default('') %}
{{ hostvars[nid].slurm_node_line | regex_replace(' Gres=\\S+', '') | regex_replace('RealMemory=\\d+', 'RealMemory=' ~ hostvars[nid].slurm_node_schedulable_memory) }}{{ (' Gres=' ~ gres) if gres else '' }} NodeAddr={{ hostvars[nid].ansible_host }} State=UNKNOWN
{% endfor %}

{% if slurm_omnistat_enabled | bool %}
# Omnistat's job file describes the whole node, so a node runs one job at a time.
PartitionName=main Nodes=ALL Default=YES MaxTime=INFINITE State=UP OverSubscribe=EXCLUSIVE
{% else %}
# Jobs share a node (separate CPUs, memory, and GPUs); CPUs are never oversubscribed.
PartitionName=main Nodes=ALL Default=YES MaxTime=INFINITE State=UP OverSubscribe=NO
{% endif %}
