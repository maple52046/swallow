# Managed by Swallow (Grafana Managed Software). Do not edit by hand; changes are overwritten.
[Unit]
Description=Swallow Grafana (container)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName={{ grafana_container_name }}
Image={{ grafana_image }}
PublishPort={{ grafana_listen_address }}:{{ grafana_port }}:3000
Environment=GF_SERVER_HTTP_PORT=3000
{% for key, value in grafana_environment | dictsort %}
Environment={{ key }}={{ value }}
{% endfor %}
Volume={{ grafana_data_dir }}:/var/lib/grafana:Z
Volume={{ grafana_config_dir }}/provisioning:/etc/grafana/provisioning:ro,z
Volume={{ grafana_config_dir }}/dashboards:{{ grafana_container_dashboards_dir }}:ro,z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
