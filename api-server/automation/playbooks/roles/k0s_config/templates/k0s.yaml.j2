{% set k0s_api_address = swallow_k0s_api_address | default(swallow_k0s_api_vip) %}
{% set k0s_ha = swallow_k0s_high_availability | default(true) | bool %}
apiVersion: k0s.k0sproject.io/v1beta1
kind: ClusterConfig
metadata:
  name: k0s
spec:
  api:
    # The selected address is a SAN for both direct non-HA access and the HA VIP.
    sans:
      - {{ k0s_api_address }}
  network:
    podCIDR: {{ swallow_k0s_pod_cidr }}
    serviceCIDR: {{ swallow_k0s_service_cidr }}
    provider: kuberouter
{% if k0s_ha %}
    # HA uses keepalived and node-local load balancing. A one-control-plane deployment
    # reaches the controller directly and must not create an unowned virtual address.
    controlPlaneLoadBalancing:
      enabled: true
      type: Keepalived
      keepalived:
        vrrpInstances:
          - virtualIPs: ["{{ swallow_k0s_api_vip }}/{{ swallow_k0s_api_vip_prefix }}"]
            authPass: "{{ swallow_k0s_vrrp_auth_pass }}"
    nodeLocalLoadBalancing:
      enabled: true
      type: EnvoyProxy
{% endif %}
  workerProfiles:
    - name: default
      values:
        failSwapOn: false
