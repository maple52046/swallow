# Official runtime images a release uses as they are, pinned by the upstream index digest.
# publish.sh checks that each one resolves to a linux/amd64 image and writes it unchanged into
# release-manifest.json; installations pull them from their own registry. GHCR holds only the
# images built from this repository.
# Review and bump these deliberately: the PostgreSQL image also hosts the co-located MAAS
# database, so it must stay PostgreSQL 14 or newer; the Site Prometheus loads its exporter
# discovery through scrape_config_files, so its image must keep that option; prom-label-proxy takes
# the platform_id from a request header (-header-name), so its image must keep that flag. Pulp runs
# on the shared PostgreSQL, so it is the pulp-minimal image (the all-in-one image always starts its
# own database), and anonymous container pull-through needs pulp_container 2.30.1 or 2.29.3 and later;
# pulp-web must stay the release matching pulp-minimal.

# mongo:8
MONGO_IMAGE=docker.io/library/mongo@sha256:5d7043a4ffe02b9ed1b6e0bab057546981af5ca0a79107e9c461e49bc44c0a7b
# postgres:16
POSTGRES_IMAGE=docker.io/library/postgres@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
# temporalio/auto-setup:1.29.7
TEMPORAL_SERVER_IMAGE=docker.io/temporalio/auto-setup@sha256:f14912b699cf73015ad5c4fc18d522d4b014db90e794039214dfb7c022c2644f
# prom/prometheus:v3.15.1 (the busybox variant: the healthcheck and swallowctl doctor use its wget)
PROMETHEUS_IMAGE=docker.io/prom/prometheus@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2
# quay.io/prometheuscommunity/prom-label-proxy:v0.15.1 (busybox-based: the healthcheck uses its wget)
PROM_LABEL_PROXY_IMAGE=quay.io/prometheuscommunity/prom-label-proxy@sha256:186f9fe791158ef25d6f810109746ac0acdb35cb8401b554526c77c065483373
# pulp/pulp-minimal:3.123.1 (pulpcore 3.123.1, pulp_container 2.30.1, pulp_deb 3.11.1, pulp_python 3.38.0, pulp_file 1.16.0)
PULP_IMAGE=docker.io/pulp/pulp-minimal@sha256:8951ed06ff1cae8d4ef2a4b3d65de63ace0c629438df75eb01e8d5b4656ef9d6
# pulp/pulp-web:3.123.1
PULP_WEB_IMAGE=docker.io/pulp/pulp-web@sha256:0b841cd427ad7e1ad69c111b54f4ba446e3adeacb178a46cad9b2c0e14bd6a9d
