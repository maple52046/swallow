# Approved upstream runtime images, pinned by digest. publish.sh mirrors them (linux/amd64
# only) into the swallow image repository; installations only ever see the mirrored references
# recorded in release-manifest.json.
# Review and bump these deliberately: the Temporal PostgreSQL image also hosts the co-located
# MAAS database, so it must stay PostgreSQL 14 or newer.

# mongo:8
UPSTREAM_MONGO_IMAGE=mongo@sha256:5d7043a4ffe02b9ed1b6e0bab057546981af5ca0a79107e9c461e49bc44c0a7b
# postgres:16
UPSTREAM_TEMPORAL_POSTGRES_IMAGE=postgres@sha256:1a6ab3f5345eb6dbe04a1349529caabdb0ab09293a09590fad07b2246bfa4b54
# temporalio/auto-setup:1.29.7
UPSTREAM_TEMPORAL_SERVER_IMAGE=temporalio/auto-setup@sha256:f14912b699cf73015ad5c4fc18d522d4b014db90e794039214dfb7c022c2644f
# temporalio/ui:2.34.0
UPSTREAM_TEMPORAL_UI_IMAGE=temporalio/ui@sha256:cb17ea423d76a8a19a269d0bcd81fc12eee1f6365acd2a56b590dafb35696a95
