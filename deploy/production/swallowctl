#!/usr/bin/env bash
# Lifecycle tool for the single-VM production installation: swallow on Docker Compose plus the
# co-located MAAS region+rack (decision 040). Run it from the Compose bundle's production/
# directory (or deploy/production in a checkout).
#
#   swallowctl install [--profile production] [--release-manifest PATH]
#   swallowctl upgrade [--force] [--release-manifest PATH]
#   swallowctl doctor | ensure [--profile production|dev]
#   swallowctl preflight | backup
#   swallowctl restore BACKUP_DIRECTORY --yes
#   swallowctl uninstall [--purge-data]
#   swallowctl ntp upstream [show | set SERVER... | default]
#
# install, upgrade, ensure, backup, restore, and uninstall need root: they install host
# packages, manage the MAAS snap, and the secrets directory is root-owned (mode 0700).
# doctor reports drift from the installation's desired state (see "Installation desired state"
# below) and ensure converges back to it. The dev profile points both at a source checkout's
# development stack (deploy/dev) instead of this installation; it needs no root.
set -euo pipefail

command_name="${1:-}"
shift || true
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
compose=(docker compose --project-directory "${script_dir}" -f "${script_dir}/compose.yaml")
backup_root="${SWALLOW_BACKUP_DIR:-${script_dir}/backups}"
env_file="${script_dir}/.env"
maas_marker="${script_dir}/state/local-maas"
default_manifest="${script_dir}/../release-manifest.json"
required_images=(SWALLOW_API_IMAGE SWALLOW_DASHBOARD_IMAGE SWALLOW_MONGO_IMAGE
  SWALLOW_POSTGRES_IMAGE SWALLOW_TEMPORAL_SERVER_IMAGE SWALLOW_PROMETHEUS_IMAGE
  SWALLOW_PROM_LABEL_PROXY_IMAGE SWALLOW_PULP_IMAGE SWALLOW_PULP_WEB_IMAGE)
managed_env_keys=(SWALLOW_RELEASE_VERSION "${required_images[@]}")
required_secrets=(mongo-root-username mongo-root-password mongo-keyfile mongo-uri temporal-db-password
  jwt-secret bootstrap-admin-password credential-key machine-token maas-db-password maas-admin-password
  pulp-db-password pulp-admin-password pulp-secret-key)
# installed_marker records the release of the last install or upgrade that passed doctor;
# install.sh upgrades only an installation that has one.
installed_marker="${script_dir}/state/installed"
# User settings that install and upgrade copy from the environment into .env.
# SWALLOW_SSH_KNOWN_HOSTS is left out: it may span lines, which .env cannot hold.
setting_keys=(SWALLOW_ADDRESS SWALLOW_MAAS_URL SWALLOW_BOOT_MEDIA_BASE_URL SWALLOW_HTTP_PORT
  SWALLOW_PULP_PORT SWALLOW_POSTGRES_HOST_PORT SWALLOW_MAAS_IMAGE_TIMEOUT SWALLOW_SITE_NAME
  SWALLOW_TEMPORAL_UI_IMAGE SWALLOW_TEMPORAL_UI_PORT SWALLOW_NTP_UPSTREAM SWALLOW_NTP_ALLOW
  SWALLOW_PROMETHEUS_RETENTION)
# The Site Prometheus loads every *.yml in prometheus_site_dir (see prometheus.yml). swallowctl
# renders the installation Site's exporter discovery there from the bundle's template; the
# directory is not in the bundle, so extracting a new release keeps it.
prometheus_site_dir="${script_dir}/state/prometheus"
prometheus_site_file="${prometheus_site_dir}/swallow-exporters.yml"
prometheus_site_template="${script_dir}/prometheus-exporters.yml.template"
# profile selects the declared stack doctor and ensure act on (see use_profile); every other
# command acts on the production installation only.
profile=production
# playbook_dir is where the Ansible executor image keeps the shared playbooks; doctor runs
# diagnostic-ping from it.
playbook_dir=/opt/swallow/automation/modules/shared/playbooks

log() { printf '[swallowctl] %s\n' "$*"; }
die() { printf '[swallowctl] %s\n' "$*" >&2; exit 1; }

require_root() {
  [[ "${EUID}" -eq 0 ]] || die "'swallowctl ${command_name}' must run as root (sudo)"
}

# shellcheck source=env.sh
source "${script_dir}/env.sh"

load_env() {
  load_installation_env "${env_file}"
}

# write_env_from_manifest copies the release version and exact image digests from a release
# manifest into .env, keeping every other user setting. The manifest is the only source of
# the required image references: the installer never substitutes tags. SWALLOW_TEMPORAL_UI_IMAGE
# is user-owned because releases do not ship the diagnostics UI.
write_env_from_manifest() {
  local manifest="$1" tmp key
  [[ -f "${manifest}" ]] || die "release manifest not found: ${manifest}"
  jq -e '.version and .images.api and .images.dashboard and .images.mongo and
    .images.postgres and .images.temporalServer and .images.prometheus and .images.promLabelProxy and
    .images.pulp and .images.pulpWeb' \
    "${manifest}" >/dev/null ||
    die "not a swallow release manifest: ${manifest}"
  tmp="$(mktemp "${script_dir}/.env.XXXXXX")"
  if [[ -f "${env_file}" ]]; then
    grep -Ev "^($(IFS='|'; printf '%s' "${managed_env_keys[*]}"))=" "${env_file}" >"${tmp}" || true
  fi
  jq -r '"SWALLOW_RELEASE_VERSION=\(.version)",
    "SWALLOW_API_IMAGE=\(.images.api)",
    "SWALLOW_DASHBOARD_IMAGE=\(.images.dashboard)",
    "SWALLOW_MONGO_IMAGE=\(.images.mongo)",
    "SWALLOW_POSTGRES_IMAGE=\(.images.postgres)",
    "SWALLOW_TEMPORAL_SERVER_IMAGE=\(.images.temporalServer)",
    "SWALLOW_PROMETHEUS_IMAGE=\(.images.prometheus)",
    "SWALLOW_PROM_LABEL_PROXY_IMAGE=\(.images.promLabelProxy)",
    "SWALLOW_PULP_IMAGE=\(.images.pulp)",
    "SWALLOW_PULP_WEB_IMAGE=\(.images.pulpWeb)"' \
    "${manifest}" >>"${tmp}"
  chmod 0600 "${tmp}"
  mv -- "${tmp}" "${env_file}"
  # The manifest wins over stale values exported in the caller's shell.
  for key in "${managed_env_keys[@]}"; do
    unset "${key}"
  done
  log "wrote $(jq -r '.version' "${manifest}") image digests to ${env_file}"
}

# env_value prints KEY's value from .env, or nothing.
env_value() {
  sed -n "s/^$1=//p" "${env_file}" 2>/dev/null | tail -n 1
}

# set_env_value replaces or appends one KEY=VALUE line in .env, keeping it mode 0600.
set_env_value() {
  local key="$1" value="$2" tmp
  tmp="$(mktemp "${script_dir}/.env.XXXXXX")"
  [[ ! -f "${env_file}" ]] || grep -v "^${key}=" "${env_file}" >"${tmp}" || true
  printf '%s=%s\n' "${key}" "${value}" >>"${tmp}"
  chmod 0600 "${tmp}"
  mv -- "${tmp}" "${env_file}"
}

# persist_settings writes the user settings set in the caller's environment into .env (the
# environment wins, as with Compose), so a later upgrade or a plain `docker compose up` sees the
# same values. It then fills in what .env still lacks from one host address: the URL machines
# use to reach MAAS and the Boot Media base URL BMCs use to reach swallow. The address is
# SWALLOW_ADDRESS, else the host of the URL MAAS was initialized with, else the primary IPv4;
# MAAS keeps the URL of its first initialization, so changing the address later is not supported.
persist_settings() {
  local key address maas_url port
  for key in "${setting_keys[@]}"; do
    [[ -n "${!key:-}" && "${!key}" != *$'\n'* ]] || continue
    set_env_value "${key}" "${!key}"
  done
  maas_url="$(env_value SWALLOW_MAAS_URL)"
  [[ -n "${maas_url}" ]] || maas_url="$(sed -n 's/^MAAS_URL=//p' "${maas_marker}" 2>/dev/null || true)"
  address="$(env_value SWALLOW_ADDRESS)"
  if [[ -z "${address}" && -n "${maas_url}" ]]; then
    address="${maas_url#*://}"
    address="${address%%/*}"
    address="${address%%:*}"
  fi
  [[ -n "${address}" ]] || address="$(primary_address)"
  [[ -n "${address}" ]] || die 'cannot detect the host address; set SWALLOW_ADDRESS (install.sh --address)'
  [[ -n "$(env_value SWALLOW_ADDRESS)" ]] || set_env_value SWALLOW_ADDRESS "${address}"
  [[ -n "$(env_value SWALLOW_MAAS_URL)" ]] ||
    set_env_value SWALLOW_MAAS_URL "${maas_url:-http://${address}:5240/MAAS}"
  if [[ -z "$(env_value SWALLOW_BOOT_MEDIA_BASE_URL)" ]]; then
    port="$(env_value SWALLOW_HTTP_PORT)"
    if [[ -z "${port}" || "${port}" == 80 ]]; then
      set_env_value SWALLOW_BOOT_MEDIA_BASE_URL "http://${address}"
    else
      set_env_value SWALLOW_BOOT_MEDIA_BASE_URL "http://${address}:${port}"
    fi
  fi
}

mark_installed() {
  install -d -m 0755 "${script_dir}/state"
  printf 'SWALLOW_RELEASE_VERSION=%s\n' "${SWALLOW_RELEASE_VERSION}" >"${installed_marker}"
}

# ensure_host_packages installs what a clean Ubuntu 24.04 lacks. Docker comes from Docker's
# signed apt repository, never the convenience script.
ensure_host_packages() {
  local -a missing=()
  local tool codename
  for tool in curl jq openssl; do
    command -v "${tool}" >/dev/null 2>&1 || missing+=("${tool}")
  done
  command -v snap >/dev/null 2>&1 || missing+=(snapd)
  command -v ip >/dev/null 2>&1 || missing+=(iproute2)
  if ((${#missing[@]} > 0)); then
    log "installing host packages: ${missing[*]}"
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y ca-certificates "${missing[@]}"
  fi
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    return 0
  fi
  log 'installing Docker Engine and the Compose plugin from the Docker apt repository'
  codename="$(. /etc/os-release && printf '%s' "${VERSION_CODENAME}")"
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\n' \
    "$(dpkg --print-architecture)" "${codename}" >/etc/apt/sources.list.d/docker.list
  apt-get update
  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
}

preflight() {
  local variable value secret
  [[ "$(uname -m)" == "x86_64" ]] || die 'amd64 is required'
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ "${ID}" == "ubuntu" && "${VERSION_ID}" == "24.04" ]] || die 'Ubuntu 24.04 is required'
  docker version >/dev/null
  docker compose version >/dev/null
  for variable in curl jq openssl snap ip; do
    command -v "${variable}" >/dev/null 2>&1 || die "missing prerequisite: ${variable}"
  done
  [[ "${SWALLOW_RELEASE_VERSION:-}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]] ||
    die 'SWALLOW_RELEASE_VERSION must be SemVer'
  for variable in "${required_images[@]}"; do
    value="${!variable:-}"
    [[ "${value}" =~ @sha256:[0-9a-f]{64}$ ]] || die "${variable} must be an exact OCI digest reference"
  done
  if [[ -n "${SWALLOW_TEMPORAL_UI_IMAGE:-}" && ! "${SWALLOW_TEMPORAL_UI_IMAGE}" =~ @sha256:[0-9a-f]{64}$ ]]; then
    die 'SWALLOW_TEMPORAL_UI_IMAGE must be an exact OCI digest reference when set'
  fi
  if [[ -n "${SWALLOW_PROMETHEUS_RETENTION:-}" &&
    ! "${SWALLOW_PROMETHEUS_RETENTION}" =~ ^(([0-9]+y)?([0-9]+w)?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?|0)$ ]]; then
    die "SWALLOW_PROMETHEUS_RETENTION must be a Prometheus duration such as 30d or 12w: '${SWALLOW_PROMETHEUS_RETENTION}'"
  fi
  [[ "$(pulp_port)" =~ ^[0-9]+$ && "$(pulp_port)" != "${SWALLOW_HTTP_PORT:-80}" ]] ||
    die "SWALLOW_PULP_PORT must be a TCP port other than SWALLOW_HTTP_PORT: '$(pulp_port)'"
  [[ -f "${prometheus_site_template}" ]] || die "missing ${prometheus_site_template##*/}: the bundle is incomplete"
  [[ -f "${script_dir}/pulp/init.sh" ]] || die 'missing pulp/init.sh: the bundle is incomplete'
  for secret in "${required_secrets[@]}"; do
    [[ -s "${script_dir}/secrets/${secret}" ]] || die "missing secret: ${secret} (run prepare-secrets.sh)"
  done
  [[ "$(stat -c %a "${script_dir}/secrets")" == "700" ]] || die 'secrets directory must be mode 0700'
  "${compose[@]}" config --quiet
  log 'preflight passed'
}

# check_ports runs only on a first install: a running stack or an installed local MAAS already
# owns its ports.
check_ports() {
  local port
  local -a ports=("${SWALLOW_HTTP_PORT:-80}" "$(pulp_port)" "${SWALLOW_POSTGRES_HOST_PORT:-5432}")
  [[ -z "$("${compose[@]}" ps -q 2>/dev/null)" ]] || return 0
  [[ -f "${maas_marker}" ]] || ports+=(5240)
  for port in "${ports[@]}"; do
    [[ -z "$(ss -Hltn "sport = :${port}" 2>/dev/null)" ]] || die "TCP port ${port} is already in use on this host"
  done
}

# pull_images fetches only images not already present, so a rerun or upgrade does not pull again.
pull_images() {
  local variable image
  for variable in "${required_images[@]}"; do
    image="${!variable}"
    docker image inspect "${image}" >/dev/null 2>&1 && continue
    log "pulling ${image}"
    docker pull --quiet "${image}" >/dev/null ||
      die "cannot pull ${image}: check access to ${image%%/*} (swallow images come from ghcr.io, the official runtime images from docker.io and quay.io)"
  done
}

# start_stores starts MongoDB and PostgreSQL and waits until both are healthy, because migrate and
# every swallow process need them: MongoDB is healthy only once its replica set has a writable
# primary (decision 069). On an installation from before the replica set, the recreated mongo
# container converts the existing data in place, and the existing mongo-uri keeps working: the
# driver discovers the replica set through the member name mongo:27017.
start_stores() {
  "${compose[@]}" up -d --wait --wait-timeout 300 mongo postgres ||
    die 'MongoDB or PostgreSQL did not become healthy (docker compose logs mongo postgres)'
}

# ensure_pulp_database creates the role and database of the Site's Local Repository (Pulp) in the
# shared PostgreSQL instance, as local-maas.sh does for MAAS, and sets the role's password from
# secrets/pulp-db-password. pulp-init migrates the database on every start, so it runs before
# Pulp starts. The password is hex (prepare-secrets.sh), so embedding it in the SQL literal is
# safe; it is sent on stdin rather than on a command line. It returns non-zero instead of exiting,
# so ensure can report the failure and go on.
ensure_pulp_database() {
  local attempt password
  password="$(<"${script_dir}/secrets/pulp-db-password")" || return 1
  if [[ ! "${password}" =~ ^[0-9a-f]+$ ]]; then
    log 'secrets/pulp-db-password must be hex'
    return 1
  fi
  for attempt in $(seq 1 60); do
    "${compose[@]}" exec -T postgres pg_isready -U temporal >/dev/null 2>&1 && break
    if [[ "${attempt}" == 60 ]]; then
      log 'the Compose PostgreSQL did not become ready'
      return 1
    fi
    sleep 2
  done
  "${compose[@]}" exec -T postgres psql -v ON_ERROR_STOP=1 -q -U temporal -d postgres >/dev/null <<SQL || return 1
SELECT 'CREATE ROLE pulp LOGIN' WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'pulp')\gexec
ALTER ROLE pulp WITH LOGIN PASSWORD '${password}';
SELECT 'CREATE DATABASE pulp OWNER pulp' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'pulp')\gexec
SQL
  log "PostgreSQL role 'pulp' and database 'pulp' are ready"
}

# pulp_database_exists tells an installation with Pulp from one installed before it, whose backup
# and restore have no Pulp to capture.
pulp_database_exists() {
  local found
  found="$("${compose[@]}" exec -T postgres psql -U temporal -d postgres -Atc \
    "SELECT count(*) FROM pg_database WHERE datname = 'pulp'")" ||
    die 'cannot list the databases of the Compose PostgreSQL'
  [[ "${found}" == 1 ]]
}

wait_for_ready() {
  local url="http://127.0.0.1:${SWALLOW_HTTP_PORT:-80}/readyz"
  for _ in $(seq 1 60); do
    curl -fsS --max-time 3 "${url}" >/dev/null 2>&1 && return 0
    sleep 3
  done
  die "the API did not become ready at ${url}"
}

# mongo_eval prints the result of one mongosh expression. The production MongoDB authenticates
# the root user from secrets/ (readable by root only); the dev stack's MongoDB has none.
mongo_eval() {
  local -a auth=()
  if [[ "${profile}" == production ]]; then
    auth=(--username "$(<"${script_dir}/secrets/mongo-root-username")"
      --password "$(<"${script_dir}/secrets/mongo-root-password")" --authenticationDatabase admin)
  fi
  "${compose[@]}" exec -T mongo mongosh --quiet "${auth[@]}" --eval "$1"
}

# mongo_database is the database the API uses: fixed in the production compose.yaml, and
# overridable through the dev stack's .env.
mongo_database() {
  if [[ "${profile}" == dev ]]; then
    printf '%s' "${SWALLOW_API_MONGO_DB:-swallow}"
  else
    printf 'swallow'
  fi
}

# active_operations counts the Workflows that have not reached a terminal status, including
# requires_attention ones still waiting for a user. Schema v4 and later keep them in
# `workflows`. upgrade counts before it migrates, so a database from before v4 still keeps its
# schema-v3 Workflows in `operations`; those are counted too. Schema-v2 records are not: no
# release runs them, and v10 drops them.
active_operations() {
  mongo_eval "const d = db.getSiblingDB('$(mongo_database)');
    const terminal = ['succeeded', 'failed', 'partially_succeeded', 'canceled'];
    print(d.workflows.countDocuments({status: {\$nin: terminal}}) +
      d.operations.countDocuments({schemaVersion: 3, status: {\$nin: terminal}}))"
}

prune_backups() {
  local prefix="$1" keep="$2" index
  local -a candidates=()
  mapfile -t candidates < <(
    find "${backup_root}" -mindepth 1 -maxdepth 1 -type d -name "${prefix}-*" -print | sort -r
  )
  for ((index = keep; index < ${#candidates[@]}; index++)); do
    rm -rf -- "${candidates[index]}"
  done
}

# take_backup writes one backup to backups/NAME-<UTC stamp> and prints its path. It captures
# MongoDB, the job artifacts, the credential key that unseals stored secrets, the Local
# Repository's Pulp database with the keys in pulp-certs that belong to it, and, when the
# co-located MAAS exists, its database (boot images re-sync from images.maas.io). Pulp's artifacts
# (volume pulp-data) are fetched again from upstream, and the Site Prometheus's metrics (volume
# prometheus-data) are disposable; neither is captured. backup.json records the release and the
# database schema it was taken from, which restore checks first. SHA256SUMS names the files
# relative to the backup, so a copy (the weekly hard link, or one moved to another host) verifies
# on its own.
take_backup() {
  local name="$1" release="${2:-$(installed_version)}" stamp target user password schema
  local -a files=(backup.json mongo.archive.gz job-artifacts.tar.gz credential-key)
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  target="${backup_root}/${name}-${stamp}"
  user="$(<"${script_dir}/secrets/mongo-root-username")"
  password="$(<"${script_dir}/secrets/mongo-root-password")"
  schema="$(database_schema_version)"
  [[ "${schema}" =~ ^[0-9]+$ ]] || die "cannot read the database schema version: ${schema}"
  install -d -m 0700 "${target}"
  jq -n --arg release "${release}" --argjson schema "${schema}" \
    --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{releaseVersion: $release, schemaVersion: $schema, createdAt: $created}' >"${target}/backup.json"
  "${compose[@]}" exec -T mongo mongodump --username "${user}" --password "${password}" \
    --authenticationDatabase admin --db swallow --archive --gzip >"${target}/mongo.archive.gz"
  "${compose[@]}" run --rm --no-deps --entrypoint tar api-server \
    -C /var/lib/swallow/jobs -czf - . >"${target}/job-artifacts.tar.gz"
  install -m 0600 "${script_dir}/secrets/credential-key" "${target}/credential-key"
  if pulp_database_exists; then
    "${compose[@]}" exec -T postgres pg_dump -U temporal -Fc pulp >"${target}/pulp.pgdump"
    # gpg-agent leaves its sockets in the GPG home; tar cannot archive them.
    "${compose[@]}" run --rm --no-deps -T --entrypoint tar pulp-init \
      -C /etc/pulp/certs --exclude='S.*' -czf - . >"${target}/pulp-certs.tar.gz"
    files+=(pulp.pgdump pulp-certs.tar.gz)
  fi
  if [[ -f "${maas_marker}" ]]; then
    "${compose[@]}" exec -T postgres pg_dump -U temporal -Fc maasdb >"${target}/maas.pgdump"
    files+=(maas.pgdump)
  fi
  (cd "${target}" && sha256sum -- "${files[@]}" >SHA256SUMS)
  printf '%s\n' "${target}"
}

# backup is the scheduled recovery point: a daily backup, hard-linked as a weekly one on Sundays,
# keeping seven daily and four weekly.
backup() {
  local target
  require_root
  load_env
  target="$(take_backup daily)"
  if [[ "$(date -u +%u)" == "7" ]]; then
    cp -al -- "${target}" "${backup_root}/weekly-${target##*/daily-}"
  fi
  prune_backups daily 7
  prune_backups weekly 4
  printf '%s\n' "${target}"
}

# ensure_deployment_key creates the Deployment Key swallow uses to log in to the Servers it deploys
# (decision 039). It is idempotent, so install and every upgrade run it after migrate; an existing
# key is kept. It needs the same MongoDB and credential key as the API, which `run` provides.
ensure_deployment_key() {
  "${compose[@]}" run --rm --no-deps api-server deployment-key ensure
}

# installation_site_id prints the id of the Site bootstrap.sh apply created, read through the API.
installation_site_id() {
  "${script_dir}/bootstrap.sh" site-id
}

# render_prometheus_site prints the exporter discovery job of one Site from the bundle's template.
# The id goes into a URL and a sed replacement, so anything but URL-safe characters is refused
# rather than escaped.
render_prometheus_site() {
  if [[ ! "$1" =~ ^[A-Za-z0-9._~-]+$ ]]; then
    printf "[swallowctl] refusing to render Prometheus discovery for the Site id '%s'\n" "$1" >&2
    return 1
  fi
  sed "s/@SWALLOW_SITE_ID@/$1/g" "${prometheus_site_template}"
}

# ensure_prometheus_site makes the Site Prometheus discover the exporters of the installation Site.
# It renders the discovery job into state/prometheus/ when the file differs (replacing it
# atomically, so Prometheus never reads a partial file) and restarts Prometheus when it has not
# loaded the file since it was written; an unchanged, loaded file leaves Prometheus untouched. It
# then waits for the job, so it needs the Site (bootstrap.sh apply) and a started Prometheus.
ensure_prometheus_site() {
  local site_id content tmp
  site_id="$(installation_site_id)" || return 1
  content="$(render_prometheus_site "${site_id}")" || return 1
  install -d -m 0755 "${prometheus_site_dir}"
  if [[ ! -f "${prometheus_site_file}" || "$(<"${prometheus_site_file}")" != "${content}" ]]; then
    tmp="$(mktemp "${prometheus_site_dir}/.swallow-exporters.XXXXXX")"
    printf '%s\n' "${content}" >"${tmp}"
    chmod 0644 "${tmp}"
    mv -- "${tmp}" "${prometheus_site_file}"
    log "rendered the exporter discovery of Site ${site_id} to ${prometheus_site_file}"
  fi
  if ! prometheus_loaded_site_file >/dev/null 2>&1; then
    log 'restarting Prometheus to load the exporter discovery'
    "${compose[@]}" restart prometheus >/dev/null || return 1
  fi
  if ! wait_for "${ensure_startup_seconds}" prometheus_runs_site_file; then
    log 'Prometheus did not load the swallow-exporters job (docker compose logs prometheus)'
    return 1
  fi
}

install_cli() {
  if [[ -x "${script_dir}/bin/swallow" ]]; then
    install -m 0755 "${script_dir}/bin/swallow" /usr/local/bin/swallow
    log 'installed the swallow CLI to /usr/local/bin/swallow'
  fi
}

primary_address() {
  ip -4 route get 1.1.1.1 2>/dev/null |
    awk '{for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit }}'
}

print_summary() {
  local address port url maas_url
  address="${SWALLOW_ADDRESS:-$(primary_address)}"
  port="${SWALLOW_HTTP_PORT:-80}"
  url="http://${address:-<this-host>}"
  [[ "${port}" == "80" ]] || url+=":${port}"
  maas_url="$(sed -n 's/^MAAS_URL=//p' "${maas_marker}" 2>/dev/null || true)"
  cat <<EOF

swallow ${SWALLOW_RELEASE_VERSION} is installed.

  Dashboard   ${url}/
  Login       admin, password: sudo cat ${script_dir}/secrets/bootstrap-admin-password
  MAAS        ${maas_url:-not installed}/  (admin, password: sudo cat ${script_dir}/secrets/maas-admin-password)
  Local repo  http://${address:-<this-host>}:$(pulp_port)/  (Pulp; deployed Servers fetch their packages and images here)

Next: sign in and add your own SSH Access Key from the account menu (SSH keys).
EOF
}

install_stack() {
  local manifest="" profile="production"
  while (($# > 0)); do
    case "$1" in
      --profile) profile="${2:?--profile needs a value}"; shift 2 ;;
      --release-manifest) manifest="${2:?--release-manifest needs a path}"; shift 2 ;;
      *) die "unknown install option: $1" ;;
    esac
  done
  [[ "${profile}" == "production" ]] ||
    die "unsupported profile '${profile}': the installation profile is 'production' (single VM)"
  require_root
  ensure_host_packages
  if [[ -z "${manifest}" && ! -f "${env_file}" && -f "${default_manifest}" ]]; then
    manifest="${default_manifest}"
  fi
  [[ -z "${manifest}" ]] || write_env_from_manifest "${manifest}"
  [[ -f "${env_file}" ]] || die 'no .env: pass --release-manifest <release-manifest.json>'
  persist_settings
  load_env
  "${script_dir}/prepare-secrets.sh"
  check_ports
  preflight
  pull_images
  start_stores
  ensure_pulp_database || die 'cannot create the Pulp role and database (docker compose logs postgres)'
  "${compose[@]}" run --rm --no-deps api-server migrate
  ensure_deployment_key
  "${compose[@]}" up -d
  wait_for_ready
  install_cli
  "${script_dir}/local-maas.sh" install
  "${script_dir}/local-maas.sh" ensure-image
  "${script_dir}/local-ntp.sh" install
  "${script_dir}/local-ntp.sh" upstream
  "${script_dir}/bootstrap.sh" apply
  ensure_prometheus_site || die 'the Site Prometheus does not discover the installation Site'
  doctor
  mark_installed
  print_summary
}

# installed_version prints the release this installation runs: the installed marker's, else the
# one in .env (an installation from before the marker).
installed_version() {
  local version
  version="$(sed -n 's/^SWALLOW_RELEASE_VERSION=//p' "${installed_marker}" 2>/dev/null || true)"
  [[ -n "${version}" ]] || version="$(env_value SWALLOW_RELEASE_VERSION)"
  printf '%s' "${version}"
}

# database_schema_version prints the schema version MongoDB records, or 0 for a database that
# migrate has not initialized.
database_schema_version() {
  mongo_eval "const m = db.getSiblingDB('$(mongo_database)').schema_metadata.findOne({_id: 'database'});
    print(m ? m.version : 0)"
}

# check_upgrade_target refuses what the target release cannot do: replace a newer installed
# release (downgrades are not supported), or serve a database a newer release already migrated
# or one older than its oldest upgrade source. A manifest from a release before these checks
# carries a stale schemaVersions.mongo, so only upgrades to later releases are protected; the
# binary still refuses to serve any schema but its own.
check_upgrade_target() {
  local manifest="$1" target installed order schema
  target="$(jq -r '.version' "${manifest}")"
  installed="$(installed_version)"
  if [[ -n "${installed}" ]]; then
    order="$(semver_compare "${target}" "${installed}")" ||
      die "cannot compare release ${target} with the installed ${installed}"
    [[ "${order}" != -1 ]] ||
      die "refusing upgrade: ${target} is older than the installed ${installed}; downgrades are not supported"
  fi
  schema="$(database_schema_version)"
  [[ "${schema}" =~ ^[0-9]+$ ]] || die "cannot read the database schema version: ${schema}"
  jq -e --argjson schema "${schema}" \
    '.schemaVersions.mongo | type == "number" and . >= $schema' "${manifest}" >/dev/null ||
    die "refusing upgrade: the database is at schema ${schema}, newer than release ${target} serves ($(jq -c '.schemaVersions.mongo' "${manifest}")); downgrades are not supported"
  jq -e --argjson schema "${schema}" \
    '$schema == 0 or $schema == .upgrade.to or (.upgrade.from | index($schema) != null)' "${manifest}" >/dev/null ||
    die "refusing upgrade: release ${target} cannot upgrade a schema ${schema} database (it upgrades from $(jq -c '.upgrade.from' "${manifest}"))"
}

# upgrade moves the installation to a release (or reapplies its own). The API, worker, and
# Ansible executor stop before the backup and the migration, so nothing writes to the database
# meanwhile and no old binary runs against the migrated schema.
upgrade() {
  local force=false manifest="" active from saved
  while (($# > 0)); do
    case "$1" in
      --force) force=true; shift ;;
      --release-manifest) manifest="${2:?--release-manifest needs a path}"; shift 2 ;;
      *) die "unknown upgrade option: $1" ;;
    esac
  done
  require_root
  load_env
  from="$(installed_version)"
  if [[ -n "${manifest}" ]]; then
    [[ -f "${manifest}" ]] || die "release manifest not found: ${manifest}"
    check_upgrade_target "${manifest}"
  fi
  active="$(active_operations)"
  if [[ "${active}" != "0" && "${force}" != true ]]; then
    die "refusing upgrade: ${active} operation(s) active; wait or pass --force"
  fi
  [[ -z "${manifest}" ]] || write_env_from_manifest "${manifest}"
  persist_settings
  load_env
  "${script_dir}/prepare-secrets.sh"
  preflight
  # An installation from before the Local Repository publishes a new port in this upgrade.
  if [[ -z "$("${compose[@]}" ps -q pulp-web 2>/dev/null)" &&
    -n "$(ss -Hltn "sport = :$(pulp_port)" 2>/dev/null)" ]]; then
    die "TCP port $(pulp_port) is already in use on this host; set SWALLOW_PULP_PORT to a free port for the Local Repository"
  fi
  pull_images
  log 'stopping the API, worker, and Ansible executor'
  "${compose[@]}" stop api-server worker ansible-executor
  saved="$(take_backup "pre-upgrade-${from:-unknown}" "${from}")"
  log "backed up to ${saved} (kept until removed by hand)"
  start_stores
  # An installation from before the Local Repository gets Pulp's database here, and its services
  # and repository Integration below.
  ensure_pulp_database || die 'cannot create the Pulp role and database (docker compose logs postgres)'
  "${compose[@]}" run --rm --no-deps api-server migrate --backup-confirmed
  ensure_deployment_key
  "${compose[@]}" up -d
  wait_for_ready
  install_cli
  # An installation from before decision 065 gets its Control-Plane NTP Server and upstream; both
  # steps are idempotent.
  "${script_dir}/local-ntp.sh" install
  "${script_dir}/local-ntp.sh" upstream
  # An installation from before decision 055 gets the rack's virsh SSH identity and records it on
  # the provisioner Integration; both steps are idempotent. bootstrap.sh also registers the Site
  # Prometheus, whose exporter discovery is then rendered for the installation Site, and the Pulp
  # as the Site's repository Integration.
  if [[ -f "${maas_marker}" ]]; then
    "${script_dir}/local-maas.sh" ensure-virsh-identity
    "${script_dir}/bootstrap.sh" apply
    ensure_prometheus_site || die 'the Site Prometheus does not discover the installation Site'
  fi
  doctor
  mark_installed
}

# verify_backup checks a backup's checksums and that it holds what restore needs. A backup from
# before SHA256SUMS used relative names lists absolute paths; only the file names are kept, so the
# files in this directory are the ones checked.
verify_backup() {
  local source="$1" file
  [[ -s "${source}/SHA256SUMS" ]] || die "${source} has no SHA256SUMS: not a swallowctl backup"
  (cd "${source}" && awk '{ sub(/^.*\//, "", $2); print $1 "  " $2 }' SHA256SUMS |
    sha256sum --check --strict --quiet -) || die "${source} does not match its SHA256SUMS"
  for file in mongo.archive.gz job-artifacts.tar.gz credential-key; do
    backup_lists "${source}" "${file}" || die "${source} is incomplete: SHA256SUMS does not list ${file}"
  done
  # The Pulp database is unreadable without the field encryption key in pulp-certs.
  if backup_lists "${source}" pulp.pgdump; then
    backup_lists "${source}" pulp-certs.tar.gz ||
      die "${source} is incomplete: SHA256SUMS lists pulp.pgdump but not pulp-certs.tar.gz"
  fi
}

# backup_lists tells whether a backup's SHA256SUMS lists the file, by name.
backup_lists() {
  awk -v name="$2" '{ sub(/^.*\//, "", $2) } $2 == name { found = 1 } END { exit !found }' "$1/SHA256SUMS"
}

# check_backup_schema refuses a backup this release cannot migrate: one taken from a newer release
# (no downgrades) or from a schema older than its oldest upgrade source. A backup from before
# backup.json is not checked; migrate still refuses a newer schema, after the data was restored.
check_backup_schema() {
  local source="$1" schema info
  if [[ ! -f "${source}/backup.json" ]]; then
    log 'the backup has no backup.json (taken before swallowctl recorded it); its schema is not checked'
    return 0
  fi
  schema="$(jq -e '.schemaVersion' "${source}/backup.json")" || die "${source}/backup.json has no schemaVersion"
  info="$("${compose[@]}" run --rm --no-deps -T api-server version --json)" ||
    die 'cannot read the schema version of the installed API image'
  jq -e --argjson schema "${schema}" '.schemaVersion >= $schema' <<<"${info}" >/dev/null ||
    die "refusing restore: the backup is at schema ${schema}, newer than this release serves ($(jq -r '.schemaVersion' <<<"${info}")); downgrades are not supported"
  jq -e --argjson schema "${schema}" '$schema >= .oldestUpgradableSchemaVersion' <<<"${info}" >/dev/null ||
    die "refusing restore: this release cannot upgrade a schema ${schema} database"
}

# terminate_workflow_runs ends every open swallow run in Temporal. Temporal is not backed up, so its
# runs belong to the store being replaced: the restored store dispatches each of its unfinished
# Workflows to a new run, and a leftover run could otherwise carry a dispatch generation the
# restored store issues again.
terminate_workflow_runs() {
  local listing id
  local -a ids=()
  listing="$("${compose[@]}" exec -T temporal temporal workflow list --address temporal:7233 \
    --query 'ExecutionStatus="Running"' -o json)" || die 'cannot list the Temporal runs'
  mapfile -t ids < <(jq -r '.[]?.execution.workflowId | select(startswith("swallow-operation/"))' <<<"${listing:-[]}")
  for id in "${ids[@]}"; do
    "${compose[@]}" exec -T temporal temporal workflow terminate --address temporal:7233 \
      --workflow-id "${id}" --reason 'swallowctl restore: the restored store dispatches its Workflows again' \
      </dev/null >/dev/null || log "could not terminate ${id}; it may have ended meanwhile"
  done
  log "terminated ${#ids[@]} Temporal run(s)"
}

# restore makes the installation's store the backup's (installation.md §3.6). The store is the
# truth: nothing writes while it is replaced, it is migrated to this release's schema, and every
# Temporal run is terminated, so the workflow-dispatch controller resumes each unfinished Workflow
# from the restored store. Tasks that finished after the backup was taken run again.
restore() {
  local source="" confirmed=false user password
  while (($# > 0)); do
    case "$1" in
      --yes) confirmed=true; shift ;;
      -*) die "unknown restore option: $1" ;;
      *) [[ -z "${source}" ]] || die 'usage: swallowctl restore BACKUP_DIRECTORY --yes'; source="$1"; shift ;;
    esac
  done
  [[ -n "${source}" ]] || die 'usage: swallowctl restore BACKUP_DIRECTORY --yes'
  require_root
  [[ -d "${source}" ]] || die "backup directory not found: ${source}"
  source="$(cd -- "${source}" && pwd)"
  load_env
  verify_backup "${source}"
  start_stores
  check_backup_schema "${source}"
  if [[ "${confirmed}" != true ]]; then
    cat >&2 <<EOF
[swallowctl] restore replaces this installation's MongoDB database, job artifacts, credential key,
[swallowctl] and (when the backup has them) the Local Repository's Pulp database and keys and the
[swallowctl] co-located MAAS database with those of
[swallowctl]   ${source}
[swallowctl] and terminates every swallow run in Temporal. Work recorded after the backup is lost,
[swallowctl] and Tasks that finished after it run again. Rerun with --yes to proceed.
EOF
    exit 1
  fi
  user="$(<"${script_dir}/secrets/mongo-root-username")"
  password="$(<"${script_dir}/secrets/mongo-root-password")"
  log 'stopping the API, worker, and Ansible executor'
  "${compose[@]}" stop api-server worker ansible-executor
  log 'restoring MongoDB'
  "${compose[@]}" exec -T mongo mongorestore --username "${user}" --password "${password}" \
    --authenticationDatabase admin --archive --gzip --drop <"${source}/mongo.archive.gz"
  log 'restoring the job artifacts'
  "${compose[@]}" run --rm --no-deps -T --entrypoint sh api-server -c \
    'find /var/lib/swallow/jobs -mindepth 1 -delete && tar -C /var/lib/swallow/jobs -xzf -' \
    <"${source}/job-artifacts.tar.gz"
  # Same mode prepare-secrets.sh uses: containers read secrets as non-root, and the 0700
  # secrets directory keeps other host users out.
  install -m 0444 "${source}/credential-key" "${script_dir}/secrets/credential-key"
  if [[ -f "${source}/pulp.pgdump" ]]; then
    restore_pulp "${source}"
  fi
  if [[ -f "${source}/maas.pgdump" && -f "${maas_marker}" ]]; then
    log 'restoring the MAAS database'
    snap stop maas
    "${compose[@]}" exec -T postgres pg_restore -U temporal --clean --if-exists \
      -d maasdb <"${source}/maas.pgdump"
    snap start maas
  fi
  "${compose[@]}" run --rm --no-deps api-server migrate --backup-confirmed
  "${compose[@]}" up -d --wait --wait-timeout 300 temporal ||
    die 'Temporal did not become healthy (docker compose logs temporal)'
  terminate_workflow_runs
  "${compose[@]}" up -d
  wait_for_ready
  if [[ -f "${source}/pulp.pgdump" ]]; then
    request_pulp_repair || log 'Pulp did not accept the repair; artifacts missing from pulp-data fail when fetched'
  fi
  doctor
}

# restore_pulp replaces the Local Repository's Pulp database and the keys that belong to it. The
# database is recreated rather than cleaned, so tables a newer Pulp added since the backup do not
# survive into it; pulp-init migrates it to the running Pulp at the next start, and resets the
# admin password to this installation's secret.
restore_pulp() {
  local source="$1"
  log "restoring the Local Repository's Pulp database and keys"
  "${compose[@]}" stop pulp-web pulp-api pulp-content pulp-worker
  "${compose[@]}" exec -T postgres psql -v ON_ERROR_STOP=1 -q -U temporal -d postgres \
    -c 'DROP DATABASE IF EXISTS pulp WITH (FORCE)'
  ensure_pulp_database || die 'cannot create the Pulp role and database (docker compose logs postgres)'
  "${compose[@]}" exec -T postgres pg_restore -U temporal -d pulp <"${source}/pulp.pgdump"
  "${compose[@]}" run --rm --no-deps -T --entrypoint sh pulp-init -c \
    'find /etc/pulp/certs -mindepth 1 -delete && tar -C /etc/pulp/certs -xzf -' \
    <"${source}/pulp-certs.tar.gz"
}

# request_pulp_repair asks Pulp to download again, from their upstreams, the artifacts the restored
# database lists but pulp-data lacks; artifacts are not backed up. Pulp repairs in the background.
request_pulp_repair() {
  wait_for 300 pulp_ready || return 1
  curl -fsS --max-time 30 --config - -H 'Content-Type: application/json' \
    --data '{"verify_checksums": false}' "http://127.0.0.1:$(pulp_port)/pulp/api/v3/repair/" >/dev/null \
    <<<"user = \"admin:$(<"${script_dir}/secrets/pulp-admin-password")\"" || return 1
  log 'Pulp is downloading the artifacts pulp-data lacks again'
}

# --- Installation desired state ----------------------------------------------------------------
#
# The probes below are the installation's health contract: the state ensure converges to and
# doctor reports drift from.
#   1. every declared Compose service runs;
#   2. MongoDB is the writable primary of the replica set rs0 (decision 069);
#   3. the Temporal cluster is healthy;
#   4. the worker polls the swallow-operations task queue with workflow and activity pollers;
#   5. the Ansible executor process runs and polls the swallow-ansible task queue with an activity
#      poller, and the shipped diagnostic-ping playbook runs;
#   6. the Dashboard and API answer /readyz on the HTTP port;
#   7. Prometheus is ready and runs the swallow-exporters job, and prom-label-proxy answers in front
#      of it and confines each query to the platform_id it is given;
#   8. the Local Repository's Pulp answers through pulp-web on its published port, with its
#      database connected and an API app, a content app, and a worker online;
#   9. production only: the co-located MAAS answers with a complete ubuntu/noble and its virsh SSH
#      identity (local-maas.sh check), the Control-Plane NTP Server serves UDP 123 with the
#      configured upstream (local-ntp.sh check), the installation records exist
#      (bootstrap.sh verify), and Prometheus runs the exporter discovery of the installation Site.
# The configuration itself (compose.yaml, the .env digests, secrets/) is declared, not converged
# here: changing it is upgrade, which backs up and migrates first.

# parse_profile_options reads the options doctor and ensure share.
parse_profile_options() {
  while (($# > 0)); do
    case "$1" in
      --profile) profile="${2:?--profile needs a value}"; shift 2 ;;
      *) die "unknown ${command_name} option: $1" ;;
    esac
  done
}

# use_profile points the stack-facing helpers at the selected profile's declared stack. production
# is the installation in this directory. dev is the source checkout's development stack
# (deploy/dev): its services run bind-mounted source under Air, and it has no secrets, co-located
# MAAS, or installation records of its own, so the release bundle (which ships no deploy/dev)
# cannot use it.
use_profile() {
  local dev_dir="${script_dir}/../dev"
  case "${profile}" in
    production) ;;
    dev)
      [[ -f "${dev_dir}/compose.yaml" ]] ||
        die "the dev profile needs a source checkout: ${dev_dir}/compose.yaml not found"
      dev_dir="$(cd -- "${dev_dir}" && pwd)"
      compose=(docker compose --project-directory "${dev_dir}" -f "${dev_dir}/compose.yaml")
      env_file="${dev_dir}/.env"
      playbook_dir=/app/modules/shared/playbooks
      ;;
    *) die "unsupported profile '${profile}': use production or dev" ;;
  esac
}

# http_port is where the Dashboard answers and proxies /readyz to the API: Nginx on the
# production HTTP port, or the Vite dev server in the dev stack.
http_port() {
  if [[ "${profile}" == dev ]]; then
    printf '%s' "${DASHBOARD_PORT:-5173}"
  else
    printf '%s' "${SWALLOW_HTTP_PORT:-80}"
  fi
}

# pulp_port is where pulp-web publishes the Local Repository on every interface of this host.
pulp_port() {
  if [[ "${profile}" == dev ]]; then
    printf '%s' "${PULP_HTTP_PORT:-8080}"
  else
    printf '%s' "${SWALLOW_PULP_PORT:-8080}"
  fi
}

# check prints one ok/FAIL line and returns the probe's status; the probe's own output is
# kept only when it fails.
check() {
  local description="$1" output
  shift
  if output="$("$@" 2>&1)"; then
    printf 'ok    %s\n' "${description}"
  else
    printf 'FAIL  %s\n' "${description}"
    [[ -z "${output}" ]] || printf '%s\n' "${output}" | tail -n 15 | sed 's/^/      /'
    return 1
  fi
}

dashboard_ready() {
  curl -fsS --max-time 5 "http://127.0.0.1:$(http_port)/readyz"
}

# pulp_ready asks Pulp for its status through pulp-web on the published port, the way deployed
# Servers reach it: the database is connected, and an API app, a content app, and a worker are
# online. A failure prints what Pulp reported.
pulp_ready() {
  local status
  status="$(curl -fsS --max-time 5 "http://127.0.0.1:$(pulp_port)/pulp/api/v3/status/")" || return 1
  jq -e '.database_connection.connected and
    ([.online_api_apps, .online_content_apps, .online_workers] | all(length > 0))' <<<"${status}" >/dev/null &&
    return 0
  jq -c '{database: .database_connection.connected, apiApps: (.online_api_apps | length),
    contentApps: (.online_content_apps | length), workers: (.online_workers | length)}' <<<"${status}"
  return 1
}

# mongo_replica_set_ready proves the store topology swallow requires (decision 069): MongoDB runs
# as the replica set rs0 and this member is its writable primary. Every swallow process refuses to
# start otherwise.
mongo_replica_set_ready() {
  mongo_eval "const h = db.hello();
    if (h.setName !== 'rs0' || !h.isWritablePrimary) {
      print('setName=' + h.setName + ' isWritablePrimary=' + h.isWritablePrimary);
      quit(1);
    }"
}

temporal_healthy() {
  "${compose[@]}" exec -T temporal temporal operator cluster health --address temporal:7233
}

# task_queue_has_pollers proves a process is connected to Temporal: the task queue named first has a
# poller of every type named after it (workflow, activity).
task_queue_has_pollers() {
  local queue="$1"
  shift
  "${compose[@]}" exec -T temporal temporal task-queue describe \
    --task-queue "${queue}" --address temporal:7233 -o json |
    jq -e '[.. | objects | .pollers? // empty | .[]? | (.taskQueueType // "" | ascii_downcase)] as $types
      | all($ARGS.positional[]; . as $type | $types | any(contains($type)))' --args "$@"
}

# worker_polls_task_queue: the worker runs the driver workflows and the provider activities.
worker_polls_task_queue() {
  task_queue_has_pollers swallow-operations workflow activity
}

# ansible_executor_polls_task_queue: the Ansible executor runs the Ansible Tasks, as activities
# of their own task queue (decision 072).
ansible_executor_polls_task_queue() {
  task_queue_has_pollers swallow-ansible activity
}

# ansible_executor_running looks for the executor process, not just its container: in the dev
# stack Air keeps the container up after the process it supervises has exited. The log line
# shows the process got past startup. grep reads its whole input (no -q) so pipefail never sees
# the producer die of SIGPIPE.
ansible_executor_running() {
  "${compose[@]}" top ansible-executor | grep -c 'swallow-api ansible-executor' >/dev/null &&
    "${compose[@]}" logs --no-log-prefix ansible-executor | grep -c 'Ansible executor started' >/dev/null
}

# ansible_runner_works runs the shipped diagnostic-ping playbook against the executor container
# itself, proving the pinned ansible-runner toolchain and the playbook tree without a Server.
# The local connection derives its temp dir from the passwd home, which does not exist in the
# read-only image, so the check points it at the writable /tmp.
ansible_runner_works() {
  "${compose[@]}" exec -T ansible-executor ansible-runner --version &&
    "${compose[@]}" exec -T -e ANSIBLE_REMOTE_TMP=/tmp/.ansible-doctor ansible-executor \
      ansible-playbook -i localhost, -c local "${playbook_dir}/diagnostic-ping.yml"
}

maas_api_answers() {
  curl -fsS --max-time 5 http://127.0.0.1:5240/MAAS/api/2.0/version/
}

# prometheus_api prints one response of the Prometheus HTTP API. Prometheus is not published on
# the host, so the request runs inside its container (the image's busybox wget).
prometheus_api() {
  "${compose[@]}" exec -T prometheus wget -q -O - "http://127.0.0.1:9090$1"
}

prometheus_ready() {
  prometheus_api /-/ready
}

# prometheus_scrapes_exporters: the swallow-exporters job is loaded. The API may list no exporter
# yet, so the job's scrape pool is checked rather than its targets.
prometheus_scrapes_exporters() {
  prometheus_api /api/v1/scrape_pools | jq -e '.data.scrapePools | index("swallow-exporters") != null' >/dev/null
}

# prometheus_loaded_site_file: Prometheus last loaded its configuration successfully, and no earlier
# than the rendered exporter discovery was written. Its status API does not show jobs loaded from
# scrape_config_files, so the load time stands in for the file's content.
prometheus_loaded_site_file() {
  local loaded
  [[ -f "${prometheus_site_file}" ]] || { printf '%s does not exist\n' "${prometheus_site_file}"; return 1; }
  loaded="$(prometheus_api /api/v1/status/runtimeinfo |
    jq -er 'select(.data.reloadConfigSuccess) | .data.lastConfigTime')" ||
    { printf 'Prometheus did not load its configuration\n'; return 1; }
  (( $(date -d "${loaded}" +%s) >= $(stat -c %Y "${prometheus_site_file}") )) ||
    { printf 'Prometheus has not loaded %s since it was written\n' "${prometheus_site_file}"; return 1; }
}

prometheus_runs_site_file() {
  prometheus_loaded_site_file && prometheus_scrapes_exporters
}

# label_proxy_confines_queries asks prom-label-proxy for `up` as a platform_id no Platform has. The
# request crosses the control network from the Prometheus container (its busybox wget), where the
# api-server reaches the proxy too. A confined query succeeds with no series, although Prometheus
# always has `up` for swallow-api once it has scraped.
label_proxy_confines_queries() {
  "${compose[@]}" exec -T prometheus wget -q -O - --header 'X-Swallow-Platform-Id: swallowctl-doctor' \
    'http://prom-label-proxy:8080/api/v1/query?query=up' |
    jq -e '.status == "success" and .data.result == []' >/dev/null
}

# prometheus_site_current: the rendered exporter discovery names the installation Site, and
# Prometheus runs it.
prometheus_site_current() {
  local site_id expected
  site_id="$(installation_site_id)" || return 1
  expected="$(render_prometheus_site "${site_id}")" || return 1
  if [[ ! -f "${prometheus_site_file}" || "$(<"${prometheus_site_file}")" != "${expected}" ]]; then
    printf '%s does not discover the exporters of Site %s\n' "${prometheus_site_file}" "${site_id}"
    return 1
  fi
  prometheus_runs_site_file
}

# report_active_operations prints how many Workflows are still in flight. It is information for
# the user, not part of the contract: a busy installation is a healthy one.
report_active_operations() {
  local active
  if active="$(active_operations 2>/dev/null)" && [[ "${active}" =~ ^[0-9]+$ ]]; then
    printf 'info  %s Workflow(s) not yet in a terminal status\n' "${active}"
  else
    printf 'info  active Workflows unknown: MongoDB did not answer\n'
  fi
}

doctor() {
  local failed=0
  load_env
  "${compose[@]}" ps
  printf '\n'
  check "Dashboard and API answer on HTTP port $(http_port)" dashboard_ready || failed=1
  check 'MongoDB is the writable primary of replica set rs0' mongo_replica_set_ready || failed=1
  check 'Temporal cluster is healthy' temporal_healthy || failed=1
  check 'worker polls the swallow-operations task queue' worker_polls_task_queue || failed=1
  check 'Ansible executor is running' ansible_executor_running || failed=1
  check 'Ansible executor polls the swallow-ansible task queue' ansible_executor_polls_task_queue || failed=1
  check 'ansible-runner runs the shipped diagnostic-ping playbook' ansible_runner_works || failed=1
  check 'Prometheus is ready' prometheus_ready || failed=1
  check 'Prometheus runs the swallow-exporters job' prometheus_scrapes_exporters || failed=1
  check 'prom-label-proxy confines queries to a platform_id' label_proxy_confines_queries || failed=1
  check "Pulp answers through pulp-web on port $(pulp_port)" pulp_ready || failed=1
  if [[ "${profile}" == production ]]; then
    "${script_dir}/local-maas.sh" check || failed=1
    "${script_dir}/local-ntp.sh" check || failed=1
    "${script_dir}/bootstrap.sh" verify || failed=1
    check 'Prometheus discovers the exporters of the installation Site' prometheus_site_current || failed=1
  else
    printf 'skip  co-located MAAS, control-plane NTP, installation records, and the installation Site'\''s exporter discovery (production profile only)\n'
  fi
  report_active_operations
  if ((failed)); then
    printf '\ndoctor found problems\n' >&2
    if [[ "${ensuring}" != true ]]; then
      if [[ "${profile}" == dev ]]; then
        printf 'run ./swallowctl ensure --profile dev to converge them\n' >&2
      else
        printf 'run sudo ./swallowctl ensure to converge them\n' >&2
      fi
    fi
    return 1
  fi
  printf '\nall checks passed\n'
}

# Seconds ensure gives a condition before acting on it. A service that was already running when
# ensure began gets a short recheck, because a failing condition there is drift. A service ensure
# just started gets its full startup window, which in the dev stack includes Air compiling it.
ensure_recheck_seconds=20
ensure_startup_seconds=240
# running_before lists the services that were running before ensure started the stack.
running_before=()
# ensuring tells doctor it is verifying ensure's result, so it does not suggest running ensure.
ensuring=false

# wait_for polls a probe every five seconds until it passes or the given seconds elapse.
wait_for() {
  local deadline=$((SECONDS + $1))
  shift
  until "$@" >/dev/null 2>&1; do
    ((SECONDS < deadline)) || return 1
    sleep 5
  done
}

# settle_seconds prints how long ensure waits on a condition owned by the given services before
# acting: the startup window if ensure started any of them, else the recheck.
settle_seconds() {
  local service running
  for service in "$@"; do
    for running in "${running_before[@]}"; do
      [[ "${running}" == "${service}" ]] && continue 2
    done
    printf '%s' "${ensure_startup_seconds}"
    return
  done
  printf '%s' "${ensure_recheck_seconds}"
}

# converge holds one condition of the desired state whose owners are Compose services: after its
# settle time it restarts them once and waits out their startup window. A condition that still
# fails is reported with the owners' recent logs, so the user sees why without running
# Compose by hand. It returns the condition's final status.
converge() {
  local description="$1" probe="$2" output
  shift 2
  if wait_for "$(settle_seconds "$@")" "${probe}"; then
    printf 'ok    %s\n' "${description}"
    return 0
  fi
  printf 'fix   %s: restarting %s\n' "${description}" "$*"
  if ! output="$("${compose[@]}" restart "$@" 2>&1)"; then
    printf '%s\n' "${output}" | tail -n 15 | sed 's/^/      /'
  fi
  if wait_for "${ensure_startup_seconds}" "${probe}"; then
    printf 'ok    %s\n' "${description}"
    return 0
  fi
  printf 'FAIL  %s; recent logs:\n' "${description}"
  "${compose[@]}" logs --tail 15 "$@" 2>&1 | sed 's/^/      /'
  return 1
}

# ensure_pulp_store starts PostgreSQL when it is not running and holds Pulp's role and database in
# it. pulp-init migrates that database whenever it starts, so ensure holds it before starting Pulp.
ensure_pulp_store() {
  "${compose[@]}" up -d --no-recreate postgres && ensure_pulp_database
}

# converge_local_maas holds the co-located MAAS conditions. MAAS keeps its database in the
# Compose PostgreSQL, so it gets the startup window when ensure just started postgres. Its boot
# image and virsh identity are converged with the idempotent steps install and upgrade use, and
# only when the read-only check fails; MAAS is never reinstalled or re-initialized here.
converge_local_maas() {
  if wait_for "$(settle_seconds postgres)" maas_api_answers; then
    printf 'ok    MAAS API answers\n'
  else
    printf 'fix   MAAS API answers: restarting the MAAS snap\n'
    snap restart maas >/dev/null 2>&1 || printf '      snap restart maas failed\n'
    if ! wait_for 450 maas_api_answers; then
      printf 'FAIL  MAAS API answers; see snap logs maas\n'
      return 1
    fi
    printf 'ok    MAAS API answers\n'
  fi
  if "${script_dir}/local-maas.sh" check >/dev/null 2>&1; then
    printf 'ok    MAAS has a complete ubuntu/noble and its virsh SSH identity\n'
    return 0
  fi
  printf 'fix   MAAS boot image or virsh SSH identity: running the local-maas.sh ensure steps\n'
  "${script_dir}/local-maas.sh" ensure-virsh-identity && "${script_dir}/local-maas.sh" ensure-image
}

# converge_local_ntp reapplies the idempotent Control-Plane NTP Server steps when the read-only
# check fails: install (nothing with the co-located MAAS) and upstream. It runs after the MAAS
# conditions because MAAS's chronyd is the server on a production host.
converge_local_ntp() {
  if "${script_dir}/local-ntp.sh" check >/dev/null 2>&1; then
    printf 'ok    control-plane NTP server serves UDP 123 with the configured upstream\n'
    return 0
  fi
  printf 'fix   control-plane NTP server: running local-ntp.sh install and upstream\n'
  "${script_dir}/local-ntp.sh" install && "${script_dir}/local-ntp.sh" upstream
}

# converge_installation_records reapplies the idempotent bootstrap (Site, MAAS Integration, the
# Site Prometheus as the metrics Integration, the Pulp as the repository Integration, and the Site
# automation defaults and the Local Repository's default source, each written only when the Site
# has none) when its read-only verify fails.
converge_installation_records() {
  if "${script_dir}/bootstrap.sh" verify >/dev/null 2>&1; then
    printf 'ok    installation records exist\n'
    return 0
  fi
  printf 'fix   installation records: running bootstrap.sh apply\n'
  "${script_dir}/bootstrap.sh" apply
}

# converge_prometheus_site renders the installation Site's exporter discovery again, restarting
# Prometheus to load it, when the read-only check fails. It runs after the installation records
# because the Site id comes from them.
converge_prometheus_site() {
  if prometheus_site_current >/dev/null 2>&1; then
    printf 'ok    Prometheus discovers the exporters of the installation Site\n'
    return 0
  fi
  printf 'fix   Prometheus exporter discovery: rendering it for the installation Site\n'
  ensure_prometheus_site
}

# ensure converges the selected stack to the installation's desired state (see "Installation
# desired state") and returns doctor's verdict on the result. It is safe to rerun: a stack that
# holds its contract is left untouched. It starts what is missing or stopped but never recreates
# a running container, so configuration and image changes stay with upgrade. It never cancels or
# retries Workflows; that is the user's call.
ensure() {
  if [[ "${profile}" == production ]]; then
    require_root
    [[ -f "${env_file}" ]] || die "no .env in ${script_dir}: nothing is installed here; run swallowctl install"
  fi
  load_env
  mapfile -t running_before < <("${compose[@]}" ps --status running --services)
  if [[ "${profile}" == production ]]; then
    check "PostgreSQL has Pulp's role and database" ensure_pulp_store || true
  fi
  log 'starting the declared services that are not running'
  "${compose[@]}" up -d --no-recreate || printf 'FAIL  docker compose up did not start every service\n'
  printf '\n'
  converge 'Temporal cluster is healthy' temporal_healthy temporal || true
  converge 'worker polls the swallow-operations task queue' worker_polls_task_queue worker || true
  converge 'Ansible executor is running' ansible_executor_running ansible-executor || true
  converge 'Ansible executor polls the swallow-ansible task queue' ansible_executor_polls_task_queue ansible-executor || true
  converge "Dashboard and API answer on HTTP port $(http_port)" dashboard_ready api-server dashboard || true
  converge 'Prometheus is ready' prometheus_ready prometheus || true
  converge 'prom-label-proxy confines queries to a platform_id' label_proxy_confines_queries prom-label-proxy || true
  converge "Pulp answers through pulp-web on port $(pulp_port)" pulp_ready pulp-api pulp-content pulp-worker pulp-web || true
  if [[ "${profile}" == production ]]; then
    if [[ -f "${maas_marker}" ]]; then
      converge_local_maas || printf 'FAIL  co-located MAAS did not converge\n'
    fi
    converge_local_ntp || printf 'FAIL  control-plane NTP server did not converge\n'
    converge_installation_records || printf 'FAIL  installation records did not converge\n'
    converge_prometheus_site || printf 'FAIL  Prometheus exporter discovery did not converge\n'
  else
    converge 'Prometheus runs the swallow-exporters job' prometheus_scrapes_exporters prometheus || true
  fi
  printf '\n'
  log 'verifying the desired state'
  ensuring=true
  if ! doctor; then
    printf 'ensure could not converge every condition; the FAIL lines above show what remains\n' >&2
    return 1
  fi
}

# remove_env_value deletes KEY from .env, keeping it mode 0600, so the setting falls back to its
# default.
remove_env_value() {
  local key="$1" tmp
  [[ -f "${env_file}" ]] || return 0
  tmp="$(mktemp "${script_dir}/.env.XXXXXX")"
  grep -v "^${key}=" "${env_file}" >"${tmp}" || true
  chmod 0600 "${tmp}"
  mv -- "${tmp}" "${env_file}"
}

# ntp_command controls the Control-Plane NTP Server's upstream (decision 065). swallowctl owns it:
# SWALLOW_NTP_UPSTREAM in .env is the setting, unset is the default (ntp.ubuntu.com), and every
# install, upgrade, and ensure reapplies it. set and default apply the change first and record it
# only when that succeeded, so a refused value never lands in .env.
#   ntp upstream [show]        the configured upstream and what the NTP server does now
#   ntp upstream set SERVER... use these IP addresses or host names, in order
#   ntp upstream default       return to the default upstream
ntp_command() {
  local subject="${1:-}" action="${2:-show}" servers
  [[ "${subject}" == upstream ]] || die 'usage: swallowctl ntp upstream [show | set SERVER... | default]'
  shift 2 || shift $#
  load_env
  case "${action}" in
    show)
      if [[ -n "$(env_value SWALLOW_NTP_UPSTREAM)" ]]; then
        log "upstream: $(env_value SWALLOW_NTP_UPSTREAM) (SWALLOW_NTP_UPSTREAM)"
      else
        log 'upstream: default (ntp.ubuntu.com)'
      fi
      "${script_dir}/local-ntp.sh" check
      ;;
    set)
      require_root
      (($# > 0)) || die 'usage: swallowctl ntp upstream set SERVER...'
      servers="$(IFS=,; printf '%s' "$*")"
      SWALLOW_NTP_UPSTREAM="${servers}" "${script_dir}/local-ntp.sh" upstream
      set_env_value SWALLOW_NTP_UPSTREAM "${servers}"
      log "recorded SWALLOW_NTP_UPSTREAM=${servers} in ${env_file}"
      ;;
    default)
      require_root
      SWALLOW_NTP_UPSTREAM='' "${script_dir}/local-ntp.sh" upstream
      remove_env_value SWALLOW_NTP_UPSTREAM
      log "removed SWALLOW_NTP_UPSTREAM from ${env_file}; the default upstream applies"
      ;;
    *) die 'usage: swallowctl ntp upstream [show | set SERVER... | default]' ;;
  esac
}

uninstall_stack() {
  local -a profile_args=()
  require_root
  load_env
  rm -f -- "${installed_marker}"
  [[ -z "${SWALLOW_TEMPORAL_UI_IMAGE:-}" ]] || profile_args=(--profile diagnostics)
  if [[ "${1:-}" == "--purge-data" ]]; then
    [[ ! -f "${maas_marker}" ]] || "${script_dir}/local-maas.sh" purge
    "${compose[@]}" "${profile_args[@]}" down --volumes --remove-orphans
    rm -rf -- "${backup_root}"
  else
    # MAAS keeps its database in the swallow PostgreSQL instance, so it stops with the stack.
    [[ ! -f "${maas_marker}" ]] || "${script_dir}/local-maas.sh" stop
    "${compose[@]}" "${profile_args[@]}" down --remove-orphans
    printf 'named volumes, secrets, backups, and the stopped MAAS snap were retained\n'
  fi
}

case "${command_name}" in
  preflight) load_env; preflight ;;
  install) install_stack "$@" ;;
  upgrade) upgrade "$@" ;;
  backup) backup ;;
  restore) restore "$@" ;;
  doctor) parse_profile_options "$@"; use_profile; doctor ;;
  ensure) parse_profile_options "$@"; use_profile; ensure ;;
  uninstall) uninstall_stack "$@" ;;
  ntp) ntp_command "$@" ;;
  *)
    printf 'usage: swallowctl {preflight|install|upgrade|ensure|backup|restore|doctor|uninstall|ntp}\n' >&2
    exit 2
    ;;
esac
