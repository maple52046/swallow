# `swallowctl install --release-manifest <release-manifest.json>` writes the version and image
# lines below from the manifest. Every image reference must be an exact @sha256 digest.
SWALLOW_RELEASE_VERSION=REPLACE_WITH_SEMVER
SWALLOW_API_IMAGE=ghcr.io/maple52046/swallow@sha256:REPLACE
SWALLOW_DASHBOARD_IMAGE=ghcr.io/maple52046/swallow@sha256:REPLACE
SWALLOW_MONGO_IMAGE=docker.io/library/mongo@sha256:REPLACE
SWALLOW_POSTGRES_IMAGE=docker.io/library/postgres@sha256:REPLACE
SWALLOW_TEMPORAL_SERVER_IMAGE=docker.io/temporalio/auto-setup@sha256:REPLACE
SWALLOW_PROMETHEUS_IMAGE=docker.io/prom/prometheus@sha256:REPLACE
SWALLOW_PROM_LABEL_PROXY_IMAGE=quay.io/prometheuscommunity/prom-label-proxy@sha256:REPLACE
SWALLOW_PULP_IMAGE=docker.io/pulp/pulp-minimal@sha256:REPLACE
SWALLOW_PULP_WEB_IMAGE=docker.io/pulp/pulp-web@sha256:REPLACE
# How long the Site Prometheus keeps metrics (a Prometheus duration such as 30d or 12w); it bounds
# the longest usage history swallow can chart. Metrics are never backed up.
# SWALLOW_PROMETHEUS_RETENTION=30d
# Optional diagnostics UI (`docker compose --profile diagnostics up -d temporal-ui`). Releases do
# not ship it: set an exact digest yourself, for example upstream temporalio/ui 2.34.0.
# SWALLOW_TEMPORAL_UI_IMAGE=temporalio/ui@sha256:cb17ea423d76a8a19a269d0bcd81fc12eee1f6365acd2a56b590dafb35696a95
SWALLOW_TEMPORAL_UI_PORT=8233
# Dashboard and API over plain HTTP. Deployed Servers reach the API at
# http://<SWALLOW_ADDRESS>:<this port> too: a Platform's Grafana reads the Platform metrics gateway
# there, and the Site Prometheus scrapes exporters from SWALLOW_ADDRESS.
SWALLOW_HTTP_PORT=80
# The Site's Local Repository (pulp-web) over plain HTTP, on every interface: deployed Servers
# fetch their packages, container images, Python packages, and files at
# http://<SWALLOW_ADDRESS>:<this port>.
SWALLOW_PULP_PORT=8080
# Loopback port where the co-located MAAS reaches the shared PostgreSQL instance.
SWALLOW_POSTGRES_HOST_PORT=5432
# NTP servers the Control-Plane NTP Server (the co-located MAAS's chronyd) follows, separated by
# commas or spaces. Unset is the default, ntp.ubuntu.com; a network that cannot reach it must set
# one, for example SWALLOW_NTP_UPSTREAM=10.0.0.123. After installation use
# `swallowctl ntp upstream set|default`, which applies the change and records it here.
# SWALLOW_NTP_UPSTREAM=
