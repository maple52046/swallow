# Every image reference must contain @sha256: and come from release-manifest.json.
SWALLOW_RELEASE_VERSION=REPLACE_WITH_SEMVER
SWALLOW_API_IMAGE=ghcr.io/example/swallow-api@sha256:REPLACE
SWALLOW_DASHBOARD_IMAGE=ghcr.io/example/swallow-dashboard@sha256:REPLACE
SWALLOW_MONGO_IMAGE=mongo@sha256:REPLACE
SWALLOW_TEMPORAL_POSTGRES_IMAGE=postgres@sha256:REPLACE
SWALLOW_TEMPORAL_SERVER_IMAGE=temporalio/auto-setup@sha256:REPLACE
SWALLOW_TEMPORAL_UI_IMAGE=temporalio/ui@sha256:REPLACE
SWALLOW_TEMPORAL_UI_PORT=8233
SWALLOW_HTTP_PORT=80
SWALLOW_HTTPS_PORT=443
