# Copy to .env and edit only the values you need to override.
# The stack runs with these exact defaults when no .env file is present.

# UID/GID the dev containers run as. Must match the owner of src/ so that files
# written from inside a container (node_modules, build output) stay editable.
DEV_UID=1001
DEV_GID=1001

# Host port mappings.
MONGO_PORT=27017
API_HTTP_PORT=30051
DASHBOARD_PORT=5173

# api-server (src/swallow) configuration.
GDCM_API_MONGO_DB=swallow
GDCM_API_JWT_SECRET=dev-secret-change-me
GDCM_API_JWT_EXPIRY_HOURS=24
GDCM_API_BOOTSTRAP_ADMIN_USERNAME=admin
GDCM_API_BOOTSTRAP_ADMIN_PASSWORD=admin

# Seals integration credentials at rest. Required. A real deployment must supply its
# own; generate one with:  openssl rand -base64 32
GDCM_API_CREDENTIAL_KEY=K7i9npJw/Fx/XbU31LyNx4vOFKFFV7PmJT0XW8eH8/s=

# Static bearer token for callers that are other systems: Prometheus pulling scrape
# targets from /api/v1/discovery/prometheus, AWX posting job notifications to
# /api/v1/webhooks/automation/{integrationId}. Treat it as a credential.
GDCM_API_MACHINE_TOKEN=dev-machine-token

# How often provisioner inventory and cluster membership are re-read, and how often
# unfinished operations are re-read from their automation controller.
GDCM_API_RECONCILE_INTERVAL=60s
GDCM_API_OPERATION_POLL_INTERVAL=15s
# How often the attached-hardware inventory (GPUs) is refreshed. Longer than the reconcile
# interval on purpose: devices cost a call per machine and change only at commissioning.
GDCM_API_INVENTORY_INTERVAL=15m

# API address the browser uses to reach the api-server.
#
# Leave empty: the dashboard derives it from whatever host the browser used to reach
# the dashboard, which covers this host, the LAN, and an SSH tunnel. Set it only when
# the API is somewhere the browser cannot infer, such as behind a reverse proxy.
VITE_API_BASE_URL=
