# Copy to .env and edit only the values you need to override.
# The stack runs with these exact defaults when no .env file is present.

# UID/GID the dev containers run as. Must match the owner of src/ so that files
# written from inside a container (node_modules, build output) stay editable.
DEV_UID=1001
DEV_GID=1001

# Host port mappings.
MONGO_PORT=27017
API_HTTP_PORT=30051
DASHBOARD_PORT=5173
PROMETHEUS_PORT=9090

# api-server (api-server) configuration.
SWALLOW_API_MONGO_DB=swallow
SWALLOW_API_JWT_SECRET=dev-secret-change-me
# Session access-token lifetime (refresh tokens renew it; see decision 042).
SWALLOW_API_ACCESS_TOKEN_TTL=15m
SWALLOW_API_BOOTSTRAP_ADMIN_USERNAME=admin
SWALLOW_API_BOOTSTRAP_ADMIN_PASSWORD=admin

# Seals integration credentials at rest. Required. A real installation must supply its
# own; generate one with:  openssl rand -base64 32
SWALLOW_API_CREDENTIAL_KEY=K7i9npJw/Fx/XbU31LyNx4vOFKFFV7PmJT0XW8eH8/s=

# Static bearer token for Prometheus metrics/discovery and external Ansible diagnostics.
SWALLOW_API_MACHINE_TOKEN=dev-machine-token

# Reconciliation, attached-hardware inventory, and operation dispatch/lease cadence.
SWALLOW_API_RECONCILE_INTERVAL=30s
SWALLOW_API_INVENTORY_INTERVAL=15m
# How often SSH Keys are re-synced to MAAS (key changes and deployments also trigger a sync).
SWALLOW_API_SSH_KEY_SYNC_INTERVAL=5m
SWALLOW_API_OPERATION_DISPATCH_INTERVAL=1s
SWALLOW_API_OPERATION_LEASE_DURATION=90s

# Boot Media (Redfish virtual media iPXE boot, decisions 047 and 049). Build Boot ISOs on
# Provisioning > Boot ISOs; they are stored under deploy/dev/boot-media/ (gitignored) and
# served from <SWALLOW_API_BOOT_MEDIA_BASE_URL>/boot-media/ipxe/<isoId>/swallow-ipxe.iso.
# Many BMCs accept only http:// on port 80, so publish the API on port 80 of an address
# the BMC network reaches.
# Leave the base URL empty to keep Boot Media off.
SWALLOW_API_BOOT_MEDIA_BASE_URL=
BOOT_MEDIA_HTTP_PUBLISH=127.0.0.1:30080
# How often newly enrolled or stale Servers get a Redfish capability probe.
SWALLOW_API_REDFISH_PROBE_INTERVAL=10m

# API address the browser uses to reach the api-server.
#
# Leave empty for the Vite same-origin /api proxy. Set only for an exceptional split-origin
# development setup.
VITE_API_BASE_URL=

# --- seed.sh inputs (Prometheus monitoring demo) ---
# Run `bash deploy/dev/seed.sh` after `docker compose up -d` to register a site, a metrics
# integration pointing at the in-compose Prometheus, and the exporter playbook mappings.
# The container image for the dev Prometheus (override to pin a digest for air-gap).
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0

# Site the seed script creates/uses.
SWALLOW_SEED_SITE_NAME=dc-east
# Where the api-server queries metrics; the in-compose Prometheus by default.
SWALLOW_PROMETHEUS_URL=http://prometheus:9090
# Optional Grafana base URL for the dashboard's deep link.
SWALLOW_GRAFANA_URL=

# MAAS provisioner (optional): set both to reconcile lab machines into servers.
# Credential format is consumer:token:secret (a MAAS API key).
SWALLOW_MAAS_URL=
SWALLOW_MAAS_CREDENTIAL=

# SSH for embedded Ansible exporter installs. knownHosts is required to enable automation.
# Automation always logs in with the Deployment Key, which seed.sh creates (the installation
# step) and the API registers in MAAS. SSH_USER is only a fallback; each OS Image's default user
# is tried first. BECOME_PASSWORD is the Site's optional sudo password.
SWALLOW_SSH_USER=ubuntu
SWALLOW_SSH_PORT=22
SWALLOW_SSH_KNOWN_HOSTS=
SWALLOW_BECOME_PASSWORD=
